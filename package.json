{
  "name": "hono-handson",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:file": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @hono-handson/api db:generate",
    "db:migrate": "pnpm --filter @hono-handson/api db:migrate",
    "dev": "pnpm --filter @hono-handson/api dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
