DATABASE_URL=postgres://postgres:postgres@localhost:5434/hono_handson
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5435/hono_handson_test
# 32 文字以上。`openssl rand -base64 32` などで生成する
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# CORS と CSRF で許可するフロントエンドのオリジン。未指定なら http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# 出力するログの最低レベル（fatal / error / warn / info / debug / trace / silent）。未指定なら info
LOG_MIN_LEVEL=info
# New Relic。秘密情報以外の設定は apps/api/src/newrelic/newrelic.cjs に置く。
# ライセンスキーは New Relic の API keys で INGEST - LICENSE のキーを発行する。
# キーを入れたら NEW_RELIC_ENABLED=true にする。false の間はエージェントを起動しない
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=
